# =============================================================================
# Inova CRM AI — Evolution API (copy to chatwoot/evolution.env)
# Profile: whatsapp-evolution | Porta host: 127.0.0.1:9416
# ADR: docs/adr/005-whatsapp-evolution-transitional.md
#
# Obrigatório — gerar valores fortes (compose fail-closed sem defaults):
#   openssl rand -hex 32
# =============================================================================

EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_REDIS_PASSWORD=

EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution

# URL que o Chatwoot (container) usa para callback — hostname Docker interno
EVOLUTION_SERVER_URL=http://crm_evolution_api:8080
# URL usada pelo script no host (VPS localhost)
EVOLUTION_PUBLIC_URL=http://127.0.0.1:9416

# Baileys / QR — deixe VAZIO (recomendado) para versão dinâmica do WhatsApp Web
EVOLUTION_PHONE_VERSION=

EVOLUTION_INSTANCE_NAME=crm-whatsapp
CHATWOOT_URL=http://crm_chatwoot_rails:3000
CHATWOOT_PUBLIC_URL=https://chat-crm.inovatitech.com.br
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_TOKEN=
CHATWOOT_INBOX_NAME="CRM WhatsApp Evolution"
